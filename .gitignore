# --- YOLO model weights (auto-download on first use; never committed) ---
*.pt

# --- Python build / cache artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- virtualenvs ---
.venv/
venv/
env/

# --- opcomm runtime channel (operator<->system files: status/command/runstate/score/overlay) ---
# Created at runtime by `python -m segugio` (default ./opcomm) and the operator console; these
# are live IPC artifacts, never source. Pass --opcomm-dir / SEGUGIO_OPCOMM_DIR to relocate.
opcomm/
# Same channel files when a process is run with channel_dir = repo root (root-anchored so we
# don't shadow legitimately-tracked JSON elsewhere in the tree).
/overlay.txt
/status.json
/command.json
/runstate.json
/score.json

# --- test fixture video binaries (external-dir + committed-manifest pattern) ---
# Real competition footage is large and may be license-restricted (consent/copyright),
# so binaries stay local and un-committed. Only the manifest + README carry provenance.
tests/fixtures/**/*.mp4
tests/fixtures/**/*.mov
tests/fixtures/**/*.avi
tests/fixtures/**/*.mkv
tests/fixtures/**/*.m4v
tests/fixtures/**/*.webm

# Condition-tag sidecars live next to the local footage (annotation inputs); the
# committed manifest captures their conditions, so the sidecars stay local too.
tests/fixtures/**/*.tags

# Keep the catalogue + provenance docs tracked even though binaries are ignored.
!tests/fixtures/README.md
!tests/fixtures/clip_manifest.yaml
